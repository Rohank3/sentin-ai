# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Application Metadata
APP_NAME=Sentin AI
APP_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/sentin_ai

# Elasticsearch Connection
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Sandbox Configuration
# Base API URL: https://api-m.sandbox.paypal.com
# Merchant Dashboard: https://sandbox.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=
PAYPAL_SELLER_ID=seller_acme

# PayPal Sandbox Test Accounts (Obtain team credentials privately from Tech Lead)
PAYPAL_BUSINESS_ACCOUNT=your_sandbox_merchant@business.example.com
PAYPAL_BUYER_ACCOUNT=your_sandbox_buyer@personal.example.com

# Automation & Risk Thresholds
AUTO_TRIAGE_ENABLED=true
MAX_AUTO_EXECUTE_AMOUNT=100.00
MIN_AUTO_EXECUTE_WIN_PROB=0.70
MAX_CUSTOMER_RISK_SCORE=0.50
