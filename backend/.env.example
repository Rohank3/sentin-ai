# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Application Metadata
APP_NAME=Sentin AI
APP_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/sentin_ai

# Elasticsearch Connection
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Sandbox Credentials (Default Platform/Seller)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Automation & Risk Thresholds
AUTO_TRIAGE_ENABLED=true
MAX_AUTO_EXECUTE_AMOUNT=100.00
MIN_AUTO_EXECUTE_WIN_PROB=0.70
MAX_CUSTOMER_RISK_SCORE=0.50
